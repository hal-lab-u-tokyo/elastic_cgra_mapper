[submodule "third_party/boost"]
	path = third_party/boost
	url = https://github.com/boostorg/boost.git
	ignore = untracked
	shallow = true
[submodule "third_party/googletest"]
	path = third_party/googletest
	url = https://github.com/google/googletest
	ignore = untracked
	shallow = true
[submodule "third_party/eigen"]
	path = third_party/eigen
	url = git@gitlab.com:libeigen/eigen.git
	ignore = untracked
	shallow = true
[submodule "benchmark/CGRA-Bench"]
	path = benchmark/CGRA-Bench
	url = https://github.com/tancheng/CGRA-Bench.git
	ignore = untracked
	shallow = true
[submodule "third_party/cxxopts"]
	path = third_party/cxxopts
	url = https://github.com/jarro2783/cxxopts.git
	ignore = untracked
	shallow = true
[submodule "third_party/vtr"]
	path = third_party/vtr
	url = https://github.com/verilog-to-routing/vtr-verilog-to-routing.git
	ignore = untracked
	shallow = true
