{
    "name": "placement2d_yott_presentation",
    "problem_type": "placement2d",
    "evaluation_mode": "placement_only",
    "mode": "placement2d_fixed_ii",
    "result_group": "placement2d/yott_presentation",
    "mapping_bin": "build/mapping",
    "benchmark_sets": [
        {
            "name": "yott_2021",
            "benchmark_root": "benchmark/literature/yott_cases2021_source_order_normalized",
            "benchmarks": [
                "mac",
                "simple",
                "horner_bs",
                "mults1",
                "arf",
                "conv3",
                "motion_vec",
                "fir2",
                "fir1",
                "fdback_pts",
                "k4n4op",
                "h2v2_smo",
                "cosine1",
                "ewf",
